# Standard Cube Mesh - 0.05m x 0.05m x 0.05m
# 8 vertices defining the corners of the cube
v -0.025 -0.025 -0.025
v  0.025 -0.025 -0.025
v  0.025  0.025 -0.025
v -0.025  0.025 -0.025
v -0.025 -0.025  0.025
v  0.025 -0.025  0.025
v  0.025  0.025  0.025
v -0.025  0.025  0.025

# Faces with correct winding order (counter-clockwise when viewed from outside)
# Bottom face (z = -0.025)
f 1 3 2
f 1 4 3

# Top face (z = 0.025)
f 5 6 7
f 5 7 8

# Front face (y = -0.025)
f 1 2 6
f 1 6 5

# Back face (y = 0.025)
f 4 8 7
f 4 7 3

# Left face (x = -0.025)
f 1 5 8
f 1 8 4

# Right face (x = 0.025)
f 2 3 7
f 2 7 6 