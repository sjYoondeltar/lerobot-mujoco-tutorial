# Standard Cube Mesh - 0.05m x 0.05m x 0.05m
# 8 vertices defining the corners of the cube
v -0.025 -0.025 -0.025
v  0.025 -0.025 -0.025
v  0.025  0.025 -0.025
v -0.025  0.025 -0.025
v -0.025 -0.025  0.025
v  0.025 -0.025  0.025
v  0.025  0.025  0.025
v -0.025  0.025  0.025

# Faces (2 triangles per quad face)
# Bottom face (z = -0.025)
f 1 2 3
f 1 3 4

# Top face (z = 0.025)
f 5 6 7
f 5 7 8

# Front face (y = -0.025)
f 1 5 6
f 1 6 2

# Back face (y = 0.025)
f 4 3 7
f 4 7 8

# Left face (x = -0.025)
f 1 4 8
f 1 8 5

# Right face (x = 0.025)
f 2 6 7
f 2 7 3 